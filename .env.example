# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# Public base URL of this service (used in TEI XML links)
BASE_URL=http://localhost:3000

# Base URL used in TEI <graphic url="..."> output.
# Example target format: https://smufl-browser.edirom.de/ED32.png
TEI_GRAPHIC_BASE_URL=https://smufl-browser.edirom.de

# ── Font metadata ─────────────────────────────────────────────────────────────
FONT_NAME=EwkwaMusic
FONT_VERSION=1.0

# ── IIIF Image Server ────────────────────────────────────────────────────────
# Base URL of the private IIIF server (no trailing slash)
IIIF_SERVER_URL=https://iiif.example.org

# Optional path prefix inserted between IIIF_SERVER_URL and the image identifier
# e.g. if full URL is https://iiif.example.org/images/<id>/full/max/0/default.png
# then set IIIF_IMAGE_PREFIX=images
IIIF_IMAGE_PREFIX=

# Authentication for the IIIF server – choose ONE:
# Option A: Bearer token
IIIF_AUTH_TOKEN=

# Option B: HTTP Basic credentials (used only if IIIF_AUTH_TOKEN is empty)
IIIF_BASIC_USER=
IIIF_BASIC_PASS=

# ── Keycloak (optional, recommended for protected image proxy) ──────────────
# If true, /glyphs/:name.png requires a valid Keycloak access token.
# Token can be provided either as Authorization: Bearer <token>
# or as cookie keycloak_token (compatible with Edirom/edirom-keycloak-handler).
KEYCLOAK_ENABLED=false

# Keycloak realm endpoint, e.g. https://auth.example.org
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=

# Expected audience in JWT (normally your Keycloak client ID)
KEYCLOAK_CLIENT_ID=

# Optional: custom JWKS endpoint. Leave empty to auto-build from base+realm.
# Default: <KEYCLOAK_BASE_URL>/realms/<KEYCLOAK_REALM>/protocol/openid-connect/certs
KEYCLOAK_JWKS_URI=

# Optional: custom URL for the client-side Edirom keycloak-handler script.
# Default: https://cdn.jsdelivr.net/npm/@edirom/keycloak-handler@latest/keycloak-handler.js
KEYCLOAK_HANDLER_SCRIPT_URL=
